// stdlib/math.prt -- pure-Proton math library.
//
// Loaded via `use math;`. Every top-level name here lives under the
// `math::` namespace: call it as math::sqrt(2.0), math::sin(PI / 2.0), etc.
// (PI and E are likewise reached as math::PI / math::E.)
//
// Values are still doubles at runtime, so these are "logical" float
// functions; integer helpers (absInt, pow's exponent) are checked against
// their declared int type on every assignment/parameter pass.

const PI: float64 = 3.14159265358979323846;
const E: float64 = 2.71828182845904523536;

fn abs(x: float64): float64 {
    if (x < 0) {
        return -x;
    }
    return x;
}

fn absInt(x: int64): int64 {
    if (x < 0) {
        return -x;
    }
    return x;
}

fn min(a: float64, b: float64): float64 {
    if (a < b) {
        return a;
    }
    return b;
}

fn max(a: float64, b: float64): float64 {
    if (a > b) {
        return a;
    }
    return b;
}

fn clamp(x: float64, lo: float64, hi: float64): float64 {
    return max(lo, min(x, hi));
}

fn lerp(a: float64, b: float64, t: float64): float64 {
    return a + (b - a) * t;
}

fn degToRad(deg: float64): float64 {
    return deg * PI / 180.0;
}

fn radToDeg(rad: float64): float64 {
    return rad * 180.0 / PI;
}

// base^exp for an integer exponent (exp may be negative).
fn pow(base: float64, exp: int32): float64 {
    if (exp == 0) {
        return 1.0;
    }
    if (exp < 0) {
        return 1.0 / pow(base, -exp);
    }
    var result: float64 = 1.0;
    for (var i: int32 = 0; i < exp; i++) {
        result = result * base;
    }
    return result;
}

// Square root via Newton-Raphson (fixed iteration count -- plenty for
// double precision starting from x itself).
fn sqrt(x: float64): float64 {
    if (x < 0) {
        panic("sqrt: negative input");
    }
    if (x == 0) {
        return 0.0;
    }
    var guess: float64 = x;
    for (var i: int32 = 0; i < 30; i++) {
        guess = (guess + x / guess) / 2.0;
    }
    return guess;
}

// Reduces x into (-PI, PI] so the Taylor series in sin stays accurate.
private fn _reduceAngle(x: float64): float64 {
    var twoPi: float64 = 2.0 * PI;
    var r: float64 = x % twoPi;
    if (r > PI) {
        r = r - twoPi;
    }
    if (r <= -PI) {
        r = r + twoPi;
    }
    return r;
}

fn sin(x: float64): float64 {
    var r: float64 = _reduceAngle(x);
    var term: float64 = r;
    var sum: float64 = r;
    for (var i: int32 = 1; i <= 8; i++) {
        var denom: float64 = (2.0 * i) * (2.0 * i + 1.0);
        term = -term * r * r / denom;
        sum = sum + term;
    }
    return sum;
}

fn cos(x: float64): float64 {
    return sin(x + PI / 2.0);
}

fn tan(x: float64): float64 {
    return sin(x) / cos(x);
}

fn floor(x: float64): float64 {
    var f: float64 = x % 1.0;
    if (f < 0) {
        f = f + 1.0;
    }
    return x - f;
}

fn ceil(x: float64): float64 {
    return -floor(-x);
}

fn round(x: float64): float64 {
    return floor(x + 0.5);
}
